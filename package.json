{
  "name": "trend-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "next build",
    "start": "next dev --turbo --port 3002 & node scripts/ssl-proxy.mjs --source 443 --target 3002 --cert certs/localhost-cert.pem --key certs/localhost-key.pem",
    "start:msw": "NEXT_PUBLIC_ENABLE_MSW=true ENABLE_MSW=true next dev --turbo --port 3002 & node scripts/ssl-proxy.mjs --source 443 --target 3002 --cert certs/localhost-cert.pem --key certs/localhost-key.pem",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:html": "bash -c 'npx prettier \"$1\" --parser html > \"$(basename \"$1\")\"' -",
    "type-check": "tsc --noEmit",
    "optimize": "node scripts/optimize.js",
    "prepare": "lefthook install",
    "lefthook:install": "lefthook install",
    "lefthook:uninstall": "lefthook uninstall",
    "swagger": "bash scripts/fetch-swagger.sh",
    "orval": "orval",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:upload": "tsx scripts/upload-hotpicks.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/third-parties": "^16.1.6",
    "@tanstack/react-query": "^5.90.9",
    "@vercel/blob": "^2.0.0",
    "axios": "^1.16.0",
    "express": "^5.2.1",
    "framer-motion": "^12.34.0",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "^1.58.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.1",
    "http-proxy": "^1.18.1",
    "lefthook": "^2.0.2",
    "msw": "^2.12.2",
    "orval": "^8.9.1",
    "prettier": "^3.3.3",
    "sass": "^1.80.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp"
    ],
    "overrides": {
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=6.0.0 <6.2.2": "^6.2.2",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "flatted@<3.4.2": "^3.4.2",
      "undici@<6.24.0": "^6.24.0",
      "fast-uri@<=3.1.1": "^3.1.2",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "lodash@>=4.0.0 <=4.17.23": "^4.18.1",
      "immutable@>=5.0.0 <5.1.5": "^5.1.5"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
